{
  "name": "mercatren",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run sw && next build",
    "sw": "serwist build serwist.config.js",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "e2e": "playwright test",
    "auditoria": "node scripts/auditoria.ts",
    "secretos": "gitleaks git --no-banner --redact",
    "verify": "npm run typecheck && npm run lint && npm run test:cobertura && npm run auditoria && npm run secretos && npm run build",
    "iconos": "node scripts/generar-iconos.mjs",
    "db:generar": "drizzle-kit generate",
    "db:estudio": "drizzle-kit studio",
    "db:local": "wrangler d1 migrations apply mercatren --local && wrangler d1 execute mercatren --local --file=.local/zelle-historico.sql",
    "zelle:importar": "node scripts/importar-zelle.ts",
    "cf:tipos": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "prepare": "husky",
    "cuenta:crear": "node scripts/crear-cuenta.ts",
    "productos:importar": "node scripts/importar-productos.ts",
    "db:schema-cloud": "node scripts/generar-schema-cloud.ts",
    "db:cargar": "node scripts/cargar-sql-produccion.ts",
    "ubicaciones:importar": "node scripts/importar-ubicaciones.ts",
    "docs:pdf": "tsx scripts/pdf-modelo.ts",
    "docs:pdf-credito": "tsx scripts/pdf-credito.ts",
    "docs:pdf-api": "tsx scripts/pdf-api.ts",
    "docs:pdf-informe": "tsx scripts/pdf-informe.ts",
    "docs:pdf-proveedores": "tsx scripts/pdf-proveedores.ts",
    "docs:pdf-manual-cliente": "tsx scripts/pdf-manual-cliente.ts",
    "docs:capturas-cliente": "tsx scripts/capturas-manual-cliente.ts",
    "docs:pdf-plano-ferreterias": "tsx scripts/pdf-plano-ferreterias.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "mediabunny": "^1.55.2",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "browserslist": "4.28.8"
  }
}

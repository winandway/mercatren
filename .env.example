# Copia este archivo como .dev.vars para trabajar en tu computadora.
# En produccion estos valores se cargan en el panel de YaDominios Cloud,
# en "Variables de entorno". NUNCA se suben al repositorio.

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITIO_URL="http://localhost:3000"
NEXT_PUBLIC_NOMBRE_SITIO="Mercatren"

# --- Sesiones ----------------------------------------------------------------
# Cadena larga y aleatoria. Generala con:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Stripe Connect ----------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# La publicable va al navegador (no es secreta). Se llama sin NEXT_PUBLIC
# a proposito: se lee en el servidor y se pasa a la pantalla, para que
# cargarla en el panel funcione sin recompilar.
STRIPE_CLAVE_PUBLICA=""

# --- Cuenta que recibe los pagos ---------------------------------------------
#
# SOLO SE RECIBE POR ZELLE (decision del negocio, 6 ago 2026).
#
# De este bloque, en produccion se cargan UNICAMENTE:
#   ZELLE_CORREO_RECEPTOR, ZELLE_NOMBRE_RECEPTOR y PAGO_SOPORTE_TELEFONO.
#
# PAGO_CUENTA, PAGO_RUTA_ACH y PAGO_RUTA_WIRE se dejan VACIAS a proposito. Si
# se cargan, la pantalla del pedido empieza a ofrecer transferencia bancaria
# — y nadie esta esperando ni validando un ACH, asi que ese dinero llegaria a
# un sitio que nadie mira. Cargarlas es una decision de negocio, no un paso de
# configuracion pendiente.
# OJO: estos valores NUNCA se escriben aquí ni en el código. Este archivo es el
# ejemplo público y va vacío a propósito.
#
# El número de cuenta junto a la ruta ACH permite intentar cobros no
# autorizados: se cargan en el panel de YaDominios Cloud (producción) y en
# .dev.vars (tu computadora, no se sube al repositorio).
#
# Si quedan vacías, la pantalla del pedido avisa que el equipo todavía no las
# configuró. Nunca inventa datos.
PAGO_BENEFICIARIO=""
PAGO_BANCO=""
PAGO_CUENTA=""
PAGO_RUTA_ACH=""
PAGO_RUTA_WIRE=""
PAGO_SOPORTE_TELEFONO=""
PAGO_SOPORTE_CORREO=""

# Quien emite las facturas de venta. Datos de registro publico, no secretos.
# Si faltan, la factura sale con el nombre de la sociedad y sin esos renglones.
EMISOR_IDENTIFICACION=""
EMISOR_DIRECCION=""

# A donde se manda una devolucion. En una sola linea, con el nombre de la
# sociedad delante. Ejemplo del formato (NO es la real):
#   Nombre de la sociedad, calle y numero, ciudad, estado y codigo postal
# Va aqui y no en el codigo porque puede cambiar dentro de un ano, y por eso
# tampoco se publica en ninguna pagina: solo la ve quien ya abrio su tramite.
# Si falta, el tramite se abre igual y se avisa al equipo para que la mande a
# mano; nunca se inventa una direccion.
DEVOLUCION_DIRECCION=""
ZELLE_CORREO_RECEPTOR=""
ZELLE_NOMBRE_RECEPTOR=""

# --- Correos -----------------------------------------------------------------
# Servicio propio de Mercatren (Cloudflare Email Sending). El remitente tiene
# que ser @mercatren.com: el dominio entero está autorizado y firmado.
CLOUDFLARE_EMAIL_TOKEN=""
CORREO_REMITENTE="Mercatren <avisos@mercatren.com>"

# --- Escudo anti-robots del login (Cloudflare Turnstile) ---------------------
# La clave del sitio es pública y va al navegador. El secreto NUNCA sale del
# servidor. Si faltan, no hay escudo y la entrada funciona como siempre.
TURNSTILE_CLAVE_SITIO=""
TURNSTILE_SECRETO=""

# La llave de las plataformas socias (QRbott). Solo sirve para VINCULAR una
# tienda. Es la credencial mas peligrosa del sistema: quien la tenga puede
# pedir el token de cualquier comercio. Minimo 32 caracteres.
SOCIO_LLAVE=""

# Token de la API de Mercury para preparar los retiros a los comercios.
# Custom scopes, SIN "Send Money": puede pedir un pago con aprobacion, no
# ejecutarlo. Se crea en Mercury > Settings > API > Tokens.
MERCURY_TOKEN=""
# De qué cuenta de Mercury sale el dinero de los retiros.
# Se saca del panel de Mercury o con la sonda de Configuración.
MERCURY_CUENTA_ID=""

# ── El agente operativo ──────────────────────────────────────────────────────
# Identifica a la vez a la cuenta y a la EMPRESA: quien lo tenga le habla al
# agente como si fuera Mercatren. SOLO SERVIDOR — nunca NEXT_PUBLIC_, o
# terminaria escrito dentro del JavaScript que descarga el navegador.
# Sin ella el sitio funciona igual, solo que sin asistente.
AGENTE_URL=""
AGENTE_TOKEN=""

# CJ Dropshipping: surte el catalogo de Estados Unidos.
CJ_API_KEY=

# La llave del robotito que sincroniza los catalogos de los comercios cada
# cuarto de hora. La usa GitHub Actions contra /datos/sincronizar.
SINCRONIZAR_LLAVE=

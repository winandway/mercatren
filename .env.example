# Copia este archivo como .dev.vars para trabajar en tu computadora.
# En produccion estos valores se cargan en el panel de YaDominios Cloud,
# en "Variables de entorno". NUNCA se suben al repositorio.

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITIO_URL="http://localhost:3000"
NEXT_PUBLIC_NOMBRE_SITIO="Mercatren"

# --- Sesiones ----------------------------------------------------------------
# Cadena larga y aleatoria. Generala con:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Stripe Connect ----------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Correos -----------------------------------------------------------------
RESEND_API_KEY=""
CORREO_REMITENTE="pedidos@mercatren.com"

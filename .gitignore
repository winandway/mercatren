# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secretos: nunca se suben. El unico que si va al repo es el ejemplo vacio.
.env*
!.env.example
.dev.vars

# Datos reales de clientes (nombres, correos, comprobantes bancarios).
# El repositorio es publico: esto NUNCA se sube. Vive solo en la base de datos.
/datos/*.json
/datos/*.csv
/.local/

# typescript
*.tsbuildinfo
next-env.d.ts

# Compilacion para YaDominios Cloud
/.open-next/
/.dist-worker/
/out-deploy/
/.wrangler/

# Service worker: lo genera Serwist en cada build
/public/sw.js
/public/sw.js.map
/public/swe-worker*.js

# Pruebas de punta a punta
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Copia de expo/tsconfig.base (SDK 58), escrita aquí a propósito: las pruebas del sitio leen piezas de la app en GitHub, donde la app no tiene sus paquetes instalados, y un «extends» a un paquete rompe esa lectura.",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "node_modules.apartado",
    "babel.config.js",
    "metro.config.js",
    "android",
    "ios"
  ]
}

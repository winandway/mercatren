{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Copia local de expo/tsconfig.base (SDK 58). Va en el repositorio a propósito: en GitHub la app no tiene sus paquetes instalados, y las pruebas del sitio leen piezas de la app. Expo solo agrega su «extends» cuando falta; como este existe, no lo toca.",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/babel.config.js",
    "${configDir}/metro.config.js",
    "${configDir}/jest.config.js",
    "${configDir}/android",
    "${configDir}/ios"
  ]
}
